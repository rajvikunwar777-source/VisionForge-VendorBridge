<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_vendor_bridge_quotation_tree" model="ir.ui.view">
        <field name="name">vendor.bridge.quotation.tree</field>
        <field name="model">vendor.bridge.quotation</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-success="state == 'accepted'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="rfq_id"/>
                <field name="vendor_id"/>
                <field name="product_name"/>
                <field name="price_unit" sum="Average Price"/>
                <field name="tax_percent"/>
                <field name="discount"/>
                <field name="price_total" sum="Total Quotation Amount"/>
                <field name="delivery_time"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-warning="state == 'submitted'" 
                       decoration-success="state == 'accepted'" 
                       decoration-danger="state == 'rejected'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_vendor_bridge_quotation_form" model="ir.ui.view">
        <field name="name">vendor.bridge.quotation.form</field>
        <field name="model">vendor.bridge.quotation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit Quote" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_accept" string="Accept Quote" type="object" class="btn-success" invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Reject Quote" type="object" class="btn-danger" invisible="state != 'submitted'"/>
                    <button name="action_set_draft" string="Reset to Draft" type="object" invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,accepted,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Quotation Reference</span>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="References">
                            <field name="rfq_id" readonly="state != 'draft'"/>
                            <field name="vendor_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="Product Details (from RFQ)">
                            <field name="product_name"/>
                            <field name="quantity"/>
                            <field name="unit"/>
                        </group>
                    </group>
                    <group>
                        <group string="Commercials">
                            <field name="price_unit" readonly="state not in ('draft', 'submitted')"/>
                            <field name="tax_percent" readonly="state not in ('draft', 'submitted')"/>
                            <field name="discount" readonly="state not in ('draft', 'submitted')"/>
                            <div class="oe_subtotal_footer oe_right">
                                <field name="price_total" class="oe_subtotal_footer_separator" widget="monetary" string="Final Total"/>
                            </div>
                        </group>
                        <group string="Logistics &amp; Terms">
                            <field name="delivery_time" readonly="state not in ('draft', 'submitted')"/>
                            <field name="warranty" placeholder="e.g. 1 Year Warranty" readonly="state not in ('draft', 'submitted')"/>
                        </group>
                    </group>
                </sheet>
                <chatter>
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_vendor_bridge_quotation_search" model="ir.ui.view">
        <field name="name">vendor.bridge.quotation.search</field>
        <field name="model">vendor.bridge.quotation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="rfq_id"/>
                <field name="vendor_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Accepted" name="accepted" domain="[('state', '=', 'accepted')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="RFQ Reference" name="group_rfq" context="{'group_by': 'rfq_id'}"/>
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vendor_bridge_quotation" model="ir.actions.act_window">
        <field name="name">Vendor Quotations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">vendor.bridge.quotation</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_vendor_bridge_quotation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record a vendor quotation!
            </p>
            <p>
                Track prices, delivery times, and warranties quoted by vendors for comparison.
            </p>
        </field>
    </record>
</odoo>
