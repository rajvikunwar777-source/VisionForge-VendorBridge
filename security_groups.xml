<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_vendor_bridge" model="ir.module.category">
            <field name="name">VendorBridge Procurement</field>
            <field name="description">Access rights for VendorBridge Procurement &amp; Vendor Management module.</field>
            <field name="sequence">20</field>
        </record>

        <!-- User Group -->
        <record id="group_vendor_bridge_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_vendor_bridge"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager Group (Approver) -->
        <record id="group_vendor_bridge_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_vendor_bridge"/>
            <field name="implied_ids" eval="[(4, ref('group_vendor_bridge_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
