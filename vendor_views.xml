<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_vendor_bridge_vendor_tree" model="ir.ui.view">
        <field name="name">vendor.bridge.vendor.tree</field>
        <field name="model">vendor.bridge.vendor</field>
        <field name="arch" type="xml">
            <tree decoration-muted="not active">
                <field name="code" readonly="1"/>
                <field name="name"/>
                <field name="contact_person"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="gst_number"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_vendor_bridge_vendor_form" model="ir.ui.view">
        <field name="name">vendor.bridge.vendor.form</field>
        <field name="model">vendor.bridge.vendor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Vendor Reference</span>
                        <h1>
                            <field name="code" placeholder="VEND00001"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Details">
                            <field name="name" placeholder="Acme Corp"/>
                            <field name="contact_person" placeholder="John Doe"/>
                            <field name="gst_number" placeholder="29AAAAA1111A1Z1"/>
                            <field name="active"/>
                        </group>
                        <group string="Contact Details">
                            <field name="email" widget="email" placeholder="vendor@example.com"/>
                            <field name="phone" widget="phone" placeholder="+1-555-0199"/>
                            <field name="address" placeholder="Complete office address..."/>
                        </group>
                    </group>
                </sheet>
                <!-- Odoo Chatter for premium feedback and activity tracking -->
                <chatter>
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_vendor_bridge_vendor_search" model="ir.ui.view">
        <field name="name">vendor.bridge.vendor.search</field>
        <field name="model">vendor.bridge.vendor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="contact_person"/>
                <field name="email"/>
                <field name="gst_number"/>
                <separator/>
                <filter string="Active Vendors" name="active_vendors" domain="[('active', '=', True)]"/>
                <filter string="Inactive Vendors" name="inactive_vendors" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Active Status" name="group_active" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_vendor_bridge_vendor_kanban" model="ir.ui.view">
        <field name="name">vendor.bridge.vendor.kanban</field>
        <field name="model">vendor.bridge.vendor</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="contact_person"/>
                <field name="email"/>
                <field name="phone"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted">
                                    Code: <field name="code"/>
                                </div>
                                <div t-if="record.contact_person.raw_value">
                                    Contact: <field name="contact_person"/>
                                </div>
                                <div t-if="record.email.raw_value">
                                    Email: <field name="email"/>
                                </div>
                                <div t-if="record.phone.raw_value">
                                    Phone: <field name="phone"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vendor_bridge_vendor" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">vendor.bridge.vendor</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_vendor_bridge_vendor_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first Vendor!
            </p>
            <p>
                Manage contact details, GST registry, and addresses for your procurement pipeline.
            </p>
        </field>
    </record>
</odoo>
